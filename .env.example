# PORT: HTTP server port for the Express + Vite full-stack server (default: 3000)
PORT=3000

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"

# VITE_APP_ENV: Runtime mode indicator (prototype | development | test)
VITE_APP_ENV="prototype"

# VITE_DEFAULT_REFERRING_FACILITY: Default referring PHC/CHC selected on launch
VITE_DEFAULT_REFERRING_FACILITY="PHC Demo North"

# VITE_DEFAULT_RECEIVING_FACILITY: Default receiving hospital selected in lookup view
VITE_DEFAULT_RECEIVING_FACILITY="District Hospital Demo"

# VITE_SMS_GATEWAY_MODE: SMS fallback mode ("simulated" for prototype; never sends real SMS)
VITE_SMS_GATEWAY_MODE="simulated"

# GEMINI_API_KEY: Reserved for optional AI Studio capabilities (not used in Xareloop clinical workflow)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
